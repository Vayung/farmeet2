# Dependencies
/node_modules/
/backend/node_modules/

# Backend environment secrets (keep .env.example)
/backend/.env
/backend/.env.*
!/backend/.env.example
*.pem
*.key
*.p12
*.pfx
*.jks

# Local environment files
/.env
/.env.*
